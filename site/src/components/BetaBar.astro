---
import type { Dict } from '../i18n/types'
import Icon from './Icon.astro'
interface Props { t: Dict }
const { t } = Astro.props
---
<aside class="beta" data-beta aria-label={t.beta.label}>
  <div class="container beta__inner">
    <p>
      <span class="beta__pill">{t.beta.label}</span>
      <span>{t.beta.text} {t.beta.ask} <a href="https://github.com/enselcuk/patchdrop/issues">{t.beta.link}</a></span>
    </p>
    <button type="button" class="beta__close" data-beta-close hidden aria-label={t.beta.dismiss}>
      <Icon name="close" size={18} />
    </button>
  </div>
</aside>
<script>
  // Dismiss for this page view only: nothing is stored.
  const bar = document.querySelector<HTMLElement>('[data-beta]')
  const btn = bar?.querySelector<HTMLButtonElement>('[data-beta-close]')
  if (bar && btn) {
    btn.hidden = false
    btn.addEventListener('click', () => { bar.hidden = true })
  }
</script>
<style>
  .beta { background: var(--amber-bg); color: var(--amber-ink); font-size: 0.9375rem; border-bottom: 1px solid #9a5b001f; }
  .beta__inner { display: flex; align-items: center; gap: 12px; padding-block: 9px; }
  .beta p { flex: 1; display: flex; align-items: baseline; gap: 10px; justify-content: center; text-align: center; line-height: 1.45; }
  .beta a { color: inherit; font-weight: 700; }
  .beta__pill {
    flex: none; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase;
    background: #fff; border: 1px solid #9a5b0033; border-radius: 999px; padding: 1px 9px;
  }
  .beta__close {
    flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px;
    background: transparent; border: 0; color: inherit; cursor: pointer;
  }
  .beta__close:hover { background: #9a5b0014; }
  @media (max-width: 560px) {
    .beta p { justify-content: flex-start; text-align: left; font-size: 0.875rem; }
  }
</style>
