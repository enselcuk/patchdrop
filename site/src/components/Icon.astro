---
{f
  ? <svg class={cls} width={size} height={size} viewBox={f.box} fill="currentColor" aria-hidden="true" focusable="false"><path d={f.d} /></svg>
  : <svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={stroke[name as keyof typeof stroke]} />}
