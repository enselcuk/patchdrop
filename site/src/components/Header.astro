---
import type { Dict, Lang } from '../i18n/types'
import LangSwitch from './LangSwitch.astro'
import logo from '../assets/logo.svg?raw'
interface Props { t: Dict; lang: Lang }
const { t, lang } = Astro.props
const home = lang === 'tr' ? '/tr/' : '/'
---
<header class="header">
  <div class="container header__inner">
    <a class="brand" href={home} aria-label={t.nav.home}>
      <span class="brand__mark" set:html={logo} />
      <span>PatchDrop</span>
    </a>
    <nav class="header__nav" aria-label={t.nav.main}>
      <a href={`${home}#how`}>{t.nav.how}</a>
      <a href={`${home}#download`}>{t.nav.download}</a>
      <a href={`${home}#faq`}>{t.nav.faq}</a>
      <a href="https://github.com/enselcuk/patchdrop">{t.nav.github}</a>
    </nav>
    <LangSwitch lang={lang} />
  </div>
</header>
<style>
  .header {
    position: sticky; top: 0; z-index: 10;
    background: #ffffffe6; backdrop-filter: saturate(1.6) blur(12px); -webkit-backdrop-filter: saturate(1.6) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner { display: flex; align-items: center; gap: 24px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.1875rem; letter-spacing: -0.02em; color: var(--ink); text-decoration: none; }
  .brand__mark { display: block; width: 32px; height: 32px; }
  .brand__mark :global(svg) { width: 100%; height: 100%; }
  .header__nav { display: flex; gap: 22px; margin-left: auto; font-size: 0.9375rem; font-weight: 600; }
  .header__nav a { color: var(--ink); text-decoration: none; padding-block: 6px; }
  .header__nav a:hover { color: var(--link); }
  .header :global(.lang-switch) { margin-left: 4px; }
  @media (max-width: 760px) {
    .header__nav { display: none; }
    .header :global(.lang-switch) { margin-left: auto; }
  }
</style>
