---
import type { Lang } from '../i18n/types'
import { getDict } from '../lib/lang'
import type { ReleaseInfo } from '../lib/release'
import Hero from './Hero.astro'
import Why from './Why.astro'
import HowItWorks from './HowItWorks.astro'
import Features from './Features.astro'
import Download from './Download.astro'
import Faq from './Faq.astro'
import MadeBy from './MadeBy.astro'
import Share from './Share.astro'
interface Props { lang: Lang; release: ReleaseInfo }
const { lang, release } = Astro.props
const t = getDict(lang)
---
<Hero t={t} lang={lang} release={release} />
<Why t={t} />
<HowItWorks t={t} />
<Features t={t} />
<Download t={t} lang={lang} release={release} />
<Share t={t} lang={lang} />
<Faq t={t} />
<MadeBy t={t} />
