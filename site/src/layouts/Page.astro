---
import Seo from '../components/Seo.astro'
import BetaBar from '../components/BetaBar.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { REDIRECT_SCRIPT, getDict } from '../lib/lang'
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url'
import manropeLatinExt from '@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url'
import '../styles/global.css'
import { GOATCOUNTER_CODE } from '../config'

interface Props {
  lang: 'en' | 'tr'
  path: '/' | '/tr/'
  /** Render as the 404 page: own title, noindex, no language redirect. */
  notFound?: boolean
}
const { lang, path, notFound = false } = Astro.props
const t = getDict(lang)
const ogImage = `https://patchdrop.enginsistem.com/og-${lang}.png`

// Only the latin and latin-ext subsets (Turkish needs latin-ext); unicode-range
// makes the browser fetch latin-ext only when the text needs it.
const fontCss = `
@font-face{font-family:'Manrope Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url(${manropeLatinExt}) format('woff2-variations');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Manrope Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url(${manropeLatin}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {path === '/' && !notFound && <script is:inline data-lang-redirect set:html={REDIRECT_SCRIPT} />}
    {notFound
      ? <>
          <title>{`${t.notFound.title} · PatchDrop`}</title>
          <meta name="description" content={t.notFound.description} />
          <meta name="robots" content="noindex" />
        </>
      : <Seo lang={lang} path={path} title={t.meta.title} description={t.meta.description} ogImage={ogImage} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
    {lang === 'tr' && <link rel="preload" href={manropeLatinExt} as="font" type="font/woff2" crossorigin />}
    <style is:inline set:html={fontCss} />
  </head>
  <body>
    {!notFound && <BetaBar t={t} />}
    <Header t={t} lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer t={t} lang={lang} />
    {!notFound && <script>import '../scripts/main'</script>}
    <script is:inline>window.goatcounter={no_onload:true}</script>
    <script is:inline async data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`} src="//gc.zgo.at/count.js"></script>
  </body>
</html>
